# ===== PostgreSQL 数据库 =====
DB_HOST=postgres
DB_PORT=5432
DB_NAME=debot_quant
DB_USER=debot_user
DB_PASSWORD=change_me_to_strong_password

# ===== Debot 网站 =====
DEBOT_BASE_URL=https://debot.ai
DEBOT_LOGIN_URL=https://debot.ai/login
DEBOT_SIGNAL_URL=https://debot.ai/signals

# ===== Cookie 文件路径（容器内路径） =====
COOKIE_FILE=/app/data/cookies.json

# ===== 采集配置 =====
POLL_INTERVAL_SECONDS=90
# 单次页面加载超时（秒）
PAGE_TIMEOUT_SECONDS=30
# 请求失败最大重试次数
MAX_RETRIES=3

# ===== 日志级别: DEBUG / INFO / WARN / ERROR =====
LOG_LEVEL=INFO
